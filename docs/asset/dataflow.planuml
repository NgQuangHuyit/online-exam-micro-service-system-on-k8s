@startuml
actor SV as "Sinh Viên"
participant C as "Client (Web/Mobile App)"
participant GW as "API Gateway"
participant QPS as "Quiz Participation Service"
participant QS as "Quiz Service"
participant RS as "Result Service"
queue "Kafka Topic" as MQ
participant Cache as "Redis cache"
database DbQPS as "ExamSession DB"
database DbQS as "QuizDB"
database DbRS as "ResultDB"

== Truy cập trang bài thi ==
SV -> C: Truy cập trang bài thi
C -> GW : GET /api/quizzes/{quizId}/info
GW -> QS : GET /{quizId}/info
QS -> DbQS : Query Quiz where quizId=quizId
DbQS --> QS : Quiz
QS --> GW : QuizInfo
GW -> C: QuizInfo
C -> GW : GET /api/quizzes/{quizId}/allowed-students
GW -> QS : GET /{quizId}/allowed-students
QS -> DbQS : Find QuizAccess where quizId=quizId
DbQS --> QS : List of {studentId, accessCode}
QS --> GW : List of allowed studentid
GW -> C: List of studentId
C -> SV : Hiển thị danh sách sinh viên, thông tin bài thi

== Xác thực truy cập và bắt đầu bài thi ==
SV -> C : Chọn studentId, accessCode
C -> GW : POST /api/quiz-participation/start-with-code
GW -> QPS : POST /start-with-code
QPS -> QS : POST /{quizId}/access-validate
QS -> DbQS : Find QuizAccess by {quizId, studentId, accessCode}
alt Không hợp lệ
    DbQS --> QS : Not Found / Invalid
    QS --> QPS : Authentication Failed
    QPS --> GW : Auth Failed
    GW --> C : Thông báo lỗi
    C -> SV : Hiển thị lỗi
else Hợp lệ
    DbQS --> QS : QuizAccess Record
    QS -> QS : Kiểm tra accessCode, khung giờ làm bài
    QS --> QPS : Valid OK
    QPS -> DbQPS : Find Quiz Participation Session by QuizID and StudentId
    alt Đã nộp bài thành công
       DbQPS--> QPS: SessionData (Submited)
       QPS --> GW: ExamSession Submited
       GW --> C: Hiện thị đã nộp bài
       C --> SV: Hiển thị đã nộp bài
    else Chưa Tạo phiên làm bài
       DbQPS-->  QPS: NotFound
       QPS -> DbQPS : Create Quiz Participation Session (STARTED)
       DbQPS --> QPS: Created
    else Đã tạo phiên làm bài, chưa nộp bài
       DbQPS --> QPS: Quiz Participation Session (STARTED)
    end

    QPS -> Cache: Get quizId_questions
         alt Cache hited
             Cache --> QPS: Question list
         else Cache missed
             Cache --> QPS: NotFound
             QPS -> QS : GET /{quizId}/questions
             QS -> DbQS : Find Questions
             DbQS --> QS : Question List
             QS --> QPS : Question List
             QPS -> Cache : Set quizid_questions
         end


    QPS --> GW : Session Data + Questions List
    GW --> C : Hiển thị câu hỏi
    C -> SV : Hiển thị câu hỏi
end

==  Quá trình làm bài ==

    SV -> C : Lưu trạng thái
    C -> C : Cache to Local Storage


== Nộp bài ==
SV -> C : Bấm "Nộp bài"
C -> GW : POST /api/quiz-participation/{sessionId}/submit
GW -> QPS : POST /{sessionId}/submit
QPS -> DbQPS : GET session:<id>
DbQPS --> QPS : Session Data
QPS -> QPS: Validate submission time

alt Quá hạn
    QPS --> GW : Submit quá hạn
    GW --> C : Thông báo lỗi
    C -> SV : Lỗi
else Hợp lệ
    QPS -> DbQPS : Start Transaction
    QPS -> DbQPS : Update session state = 'submited'
    QPS -> DbQPS : Insert Outbox Event (state = 'pending')
    QPS -> DbQPS : Commit Transaction
    DbQPS -> QPS : Transaction Complete
    QPS --> GW : Submit OK
    GW --> C : Nộp bài thành công
    C -> SV : Hiển thị thông báo
end

== Publish Submmision Message ==

loop Scheduled Task Every 5 minutes
    QPS -> DbQPS : Query Outbox Event (state = 'pending' || state = 'failed')
    DbQPS -> QPS : List OutboxEvents
    loop For each event
        QPS -> MQ: Publish Submit Message
        MQ --> QPS: ACK
        QPS -> DbQPS: Update OutboxEvent state = 'processed'
    end
end

== Chấm điểm và ghi nhận kết quả làm bài ==
MQ -> RS : Consume Submit Message
RS -> DbRS : Exist Result by SessionId

alt Result By SessionId exists
   DbRS -> RS: Result Exist
   RS -> MQ : ACK Submit Message
else Result By SessionId Not Exists
   DbRS -> RS: Result Not Exist
RS -> Cache : Get quizid:answers
alt cache hited
     Cache --> RS: value of quizid:answers
else cache missed
     RS -> QS : GET /{quizId}/answers
     QS -> DbQS : Correct Answers
     DbQS --> QS : Answer List
     QS --> RS : Answer List
     RS -> Cache : cache quizid:answers
end

RS -> RS: Chấm điểm bài thi
RS -> DbRS : Save Result
DbRS --> RS : OK
RS -> MQ : ACK Submit Message
end


@enduml